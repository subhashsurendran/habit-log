{
  "expo": {
    "name": "MyDTC",
    "slug": "habit-log",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/mydtc-logo.png",
    "backgroundColor": "#16121C",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "5",
      "infoPlist": {
        "CFBundleDisplayName": "MyDTC",
        "NSMicrophoneUsageDescription": "MyDTC uses the microphone for a journal voice note stored on this phone.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16121C",
          "image": "./assets/mydtc-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      "expo-iap"
    ]
  }
}
